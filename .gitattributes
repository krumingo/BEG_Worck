# Shell scripts run on Linux (Synology): they must be committed, checked out and
# exported with LF line endings. Without this rule, core.autocrlf=true on a
# Windows PC converts LF->CRLF on checkout AND on `git archive`, and the CRLF
# wrapper broke bash on Synology ("invalid option name").
*.sh text eol=lf

# Test doubles executed by bash on Linux/Synology (no .sh extension).
ops/release/tests/fakes/* text eol=lf
ops/dr/tests/fakes/* text eol=lf

# Mounted into a Linux container by the W0-10A restore proof.
ops/dr/*.js text eol=lf
