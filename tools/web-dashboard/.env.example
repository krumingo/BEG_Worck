# BEG_WORK web dashboard configuration.
#
# Copy to .env next to docker-compose.yml and fill in the token. .env is git-ignored;
# never commit a real token, and never paste one into an issue, a PR or a screenshot.
#
#   cp .env.example .env
#
# THIS FILE CONTAINS NO SECRET AND MUST NOT EVER CONTAIN ONE.

# ---------------------------------------------------------------------------
# GitHub read-only access
# ---------------------------------------------------------------------------
# A fine-grained personal access token with, at most:
#   Repository access : only krumingo/BEG_Worck
#   Permissions       : Contents = Read-only, Pull requests = Read-only
# Nothing else is needed, and nothing else should be granted. The dashboard's
# transport refuses any non-GET/HEAD request, so a token with write scope would
# still never be used to write -- but do not grant it.
#
# Leave empty to read anonymously. Anonymous reads work only for a public
# repository and are limited to 60 requests/hour, which is below what a 15 s
# cadence needs, so a token is recommended.
BEGWORK_GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# What to project
# ---------------------------------------------------------------------------
BEGWORK_REPOSITORY=krumingo/BEG_Worck
BEGWORK_BRANCH=codex/claude-queue

# ---------------------------------------------------------------------------
# Refresh behaviour
# ---------------------------------------------------------------------------
# Seconds between read rounds. Clamped to 10-30 by the application.
BEGWORK_REFRESH_SECONDS=15

# A successful read older than this is shown as AGED. Measured from the read, not
# from validated_at: a task legitimately blocked for days is not a stale reading.
BEGWORK_STALE_AFTER_SECONDS=120

# Bounded backoff after a failed read: 10, 20, 40, 80, then capped at 120 s.
BEGWORK_BACKOFF_INITIAL_SECONDS=10
BEGWORK_BACKOFF_MAX_SECONDS=120
BEGWORK_REQUEST_TIMEOUT_SECONDS=15

# Verify the cited exact PR head against live PR metadata. Turning this off makes the
# PR head unverified, which the dashboard then reports as STALE rather than hiding.
BEGWORK_VERIFY_PULL_REQUEST=true

# ---------------------------------------------------------------------------
# Acceptance mode  --  LEAVE OFF IN NORMAL RUNTIME
# ---------------------------------------------------------------------------
# Enables synthetic STALE / CONFLICT / INVALID / OFFLINE scenarios at
# /?acceptance=<name>, for acceptance testing on a test container.
#
# The scenarios mutate an already-read snapshot in memory and re-run the real
# verifier: no GitHub request is issued, no canonical queue file is touched,
# nothing is persisted, and no scenario can report VALID or verified. While this
# is false the endpoint 404s like any unknown path.
#
# /healthz reports acceptance_mode, so a test box is distinguishable from a
# production one at a glance.
BEGWORK_ACCEPTANCE_MODE=false

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------
# Inside the container. The published host port is set in docker-compose.yml.
BEGWORK_HOST=0.0.0.0
BEGWORK_PORT=8080

# Point at a GitHub Enterprise API root if ever needed. Leave as-is otherwise.
BEGWORK_API_BASE=https://api.github.com
