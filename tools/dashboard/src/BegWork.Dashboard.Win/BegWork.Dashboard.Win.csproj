<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-only by design: the shell is WPF plus Win32 AppBar interop.
         Everything testable lives in BegWork.Dashboard.Core, which targets plain
         net8.0 so it builds and runs its tests on any host. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BegWork.Dashboard</AssemblyName>
    <RootNamespace>BegWork.Dashboard.Win</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BegWork.Dashboard.Core/BegWork.Dashboard.Core.csproj" />
  </ItemGroup>

</Project>
